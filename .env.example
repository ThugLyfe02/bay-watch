# eBay developer application credentials. Never commit real values.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Tokens are minted/refreshed in memory when client credentials are configured.
# These static-token overrides are for short manual checks only; access tokens expire.
EBAY_APPLICATION_ACCESS_TOKEN=
# Long-lived user refresh token from eBay OAuth consent with the Offer auction scope.
# Keep it in a secret manager in deployment; never commit a real value.
EBAY_USER_REFRESH_TOKEN=
# Optional short-lived user access-token override for troubleshooting only.
EBAY_USER_ACCESS_TOKEN=
EBAY_MARKETPLACE=EBAY_US
EBAY_API_ENV=sandbox
AUCTION_SCOUT_DB=./auction_scout.sqlite3

