# eBay developer application credentials. Never commit real values.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# User access token with https://api.ebay.com/oauth/api_scope/buy.offer.auction
# Keep it in a secret manager in deployment; environment variable shown for local use only.
EBAY_USER_ACCESS_TOKEN=
EBAY_MARKETPLACE=EBAY_US
EBAY_API_ENV=sandbox
AUCTION_SCOUT_DB=./auction_scout.sqlite3

